{
  "schemaVersion": 1,
  "id": "io.github.doctahw.omaproton-pass",
  "name": "OmaProton Pass",
  "version": "0.1.0",
  "author": "doctahw",
  "license": "MIT",
  "description": "Proton Pass in the Omarchy bar: browse your vaults and copy usernames and passwords in one click, in your theme.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "OmaProton Pass",
    "description": "Browse Proton Pass vaults and copy usernames, passwords and TOTP codes without leaving the bar.",
    "category": "Security",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 45
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Session check interval (seconds)",
        "min": 10,
        "max": 3600,
        "step": 5,
        "defaultValue": 45
      }
    ]
  }
}
